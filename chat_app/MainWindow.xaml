<Window x:Class="LlamaChatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LlamaChatApp"
        xmlns:viewmodels="clr-namespace:LlamaChatApp.ViewModels"
        xmlns:md="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        mc:Ignorable="d"
        Title="LlamaChat" Height="820" Width="1000"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- Converters -->
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Markdown visibility styles during editing -->
        <Style x:Key="InverseVisibilityBasedOnIsEditing" TargetType="md:MarkdownViewer">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Message Context Menu -->
        <ContextMenu x:Key="MessageContextMenu" DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Regenerate"
                      Command="{Binding RegenerateResponseCommand}"
                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Copy"
                      Command="{Binding CopyMessageCommand}"
                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Edit"
                      Click="EditMessage_Click"
                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Delete"
                      Command="{Binding DeleteMessageCommand}"
                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewConversationCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseConversationCommand}" CommandParameter="{Binding CurrentConversation}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadModelCommand}" />
        <KeyBinding Key="U" Modifiers="Control" Command="{Binding UnloadModelCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadModelCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearChatCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Menu -->
            <RowDefinition Height="Auto" /> <!-- Tabs & Document List -->
            <RowDefinition Height="Auto" /> <!-- System Prompt card -->
            <RowDefinition Height="*" />    <!-- Chat area -->
            <RowDefinition Height="Auto" /> <!-- User input bar -->
            <RowDefinition Height="Auto" /> <!-- Settings slider panel -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Menu Grid.Row="0" Padding="6,4" Background="{DynamicResource SettingsBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Model..." Command="{Binding LoadModelCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Unload Model" Command="{Binding UnloadModelCommand}" InputGestureText="Ctrl+U" />
                <MenuItem Header="_Reload / Apply Settings" Command="{Binding ReloadModelCommand}" InputGestureText="Ctrl+R" />
                <Separator Background="{DynamicResource BorderBrush}" />
                <MenuItem Header="_Export Conversation..." Command="{Binding ExportConversationCommand}" />
                <MenuItem Header="_Import Conversation..." Command="{Binding ImportConversationCommand}" />
                <Separator Background="{DynamicResource BorderBrush}" />
                <MenuItem Header="_Clear Chat" Command="{Binding ClearChatCommand}" InputGestureText="Ctrl+L" />        
                <Separator Background="{DynamicResource BorderBrush}" />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Themes">
                <MenuItem Header="_Light Theme" Command="{Binding SwitchToLightThemeCommand}" />
                <MenuItem Header="_Dark Theme" Command="{Binding SwitchToDarkThemeCommand}" />
            </MenuItem>
        </Menu>

        <!-- Conversation Tabs & Document List Panel -->
        <Border Grid.Row="1" Background="{DynamicResource SettingsBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tabs row -->
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="＋ New Chat" Padding="12,4" Command="{Binding NewConversationCommand}" />
                    <TabControl ItemsSource="{Binding Conversations}"
                                SelectedItem="{Binding CurrentConversation, Mode=TwoWay}"
                                Height="34"
                                Margin="0,0,15,0"
                                Background="Transparent"
                                BorderThickness="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12.5" Margin="4,0,8,0"/>
                                    <Button Content="✕" Style="{StaticResource CloseTabButtonStyle}"
                                            Command="{Binding DataContext.CloseConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>
                </DockPanel>

                <!-- Attached Documents Row -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding CurrentConversation.AttachedDocuments}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CodeBlockBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,8,6" Padding="10,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📎" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontSize="11.5" MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Button Content="✕" Style="{StaticResource CloseTabButtonStyle}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- System Prompt Card Area -->
        <Border Grid.Row="2" Margin="15,12,15,6" Background="{DynamicResource SettingsBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" IsEnabled="{Binding IsIdle}">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SYSTEM INSTRUCTIONS" FontWeight="Bold" FontSize="10" Margin="2,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox Grid.Row="1" Text="{Binding SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         MinLines="1" MaxLines="3" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent" Padding="0,2,0,0" FontSize="12.5"/>
            </Grid>
        </Border>

        <!-- Chat View Area -->
        <ListView x:Name="ChatListView" Grid.Row="3" Margin="15,6,15,12"
                  ItemsSource="{Binding ChatMessages}"
                  BorderThickness="0"
                  Background="Transparent"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  LayoutUpdated="ChatListView_LayoutUpdated">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChatMessage}">
                    <Grid Margin="0,4">
                        <StackPanel HorizontalAlignment="{Binding Alignment}" MaxWidth="750">
                            <!-- Header metadata -->
                            <DockPanel LastChildFill="True" Margin="6,0,6,3" Opacity="0.85">
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Bottom"
                                           Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding Author}"
                                           Foreground="{Binding AuthorBrush}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"/>
                            </DockPanel>

                            <!-- Chat bubble border with custom trigger colors -->
                            <Border x:Name="bubbleBorder" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AssistantBubbleBackgroundBrush}" />
                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AssistantBubbleTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Author}" Value="User">
                                                <Setter Property="Background" Value="{DynamicResource UserBubbleBackgroundBrush}" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource UserBubbleTextBrush}" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Author}" Value="System">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="TextBlock.Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Author}" Value="Error">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="TextBlock.Foreground" Value="#FF453A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <StackPanel>
                                        <Border Background="Transparent"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ContextMenu="{StaticResource MessageContextMenu}"
                                                PreviewMouseRightButtonUp="ChatBubble_PreviewMouseRightButtonUp">
                                            <Grid>
                                                <!-- Edit mode input -->
                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                         Padding="12" Background="Transparent" BorderThickness="0" AcceptsReturn="True" FontSize="13.5" />
                                                
                                                <!-- Normal markdown text -->
                                                <md:MarkdownViewer Markdown="{Binding Text}"
                                                                   Padding="12"
                                                                   Background="Transparent"
                                                                   Style="{StaticResource InverseVisibilityBasedOnIsEditing}"
                                                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Metrics Display footer -->
                                        <StackPanel Orientation="Horizontal" Margin="12,0,12,6" 
                                                    Visibility="{Binding HasMetrics, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Opacity="0.65">
                                            <TextBlock Text="{Binding Metrics.TokenCount, StringFormat='{}{0} tokens'}" FontSize="9.5" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding Metrics.ElapsedTime, StringFormat='{}{0:s\\.fff}s'}" FontSize="9.5" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding Metrics.TokensPerSecond, StringFormat='{}{0:F2} t/s'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>

                                        <!-- Edit Save/Cancel Actions -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,8" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Content="Save" Click="SaveEdit_Click" CommandParameter="{Binding}" Margin="0,0,6,0" Style="{StaticResource AccentButtonStyle}" Padding="10,4" />
                                            <Button Content="Cancel" Click="CancelEdit_Click" CommandParameter="{Binding}" Padding="10,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- User Input Bar -->
        <Grid Grid.Row="4" Margin="15,4,15,12" IsEnabled="{Binding IsModelLoaded}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="📎 Attach PDF" Margin="0,0,10,0" Padding="15,10" FontSize="13.5" FontWeight="SemiBold"
                    Command="{Binding AttachPdfCommand}" IsEnabled="{Binding IsIdle}" ToolTip="Attach a PDF to automatically feed relevant parts into the context."/>

            <TextBox x:Name="InputTextBox" Text="{Binding UserInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Grid.Column="1" 
                     VerticalContentAlignment="Center" 
                     FontSize="13.5"
                     Padding="12,10"
                     KeyDown="UserInputTextBox_KeyDown"
                     AcceptsReturn="True"
                     IsEnabled="{Binding IsIdle}"
                     Style="{StaticResource ModernWatermarkTextBoxStyle}"
                     Tag="Ask a question, or request a summary... (Enter to send, Shift+Enter for newline)"/>

            <!-- Cancel/Stop Button -->
            <Button Grid.Column="2" Content="Stop" Margin="10,0,0,0" Padding="18,10" FontSize="13.5" FontWeight="SemiBold"
                    IsEnabled="{Binding IsGenerating}" Command="{Binding StopGenerationCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#FEE2E2" />
                        <Setter Property="Foreground" Value="#991B1B" />
                        <Setter Property="BorderBrush" Value="#FCA5A5" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#FCA5A5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Grid.Column="3" Content="Send" Margin="10,0,0,0" Padding="25,10" FontSize="13.5" FontWeight="SemiBold"
                    Style="{StaticResource AccentButtonStyle}" Command="{Binding SendMessageCommand}" IsDefault="True" Click="SendButton_Click"/>
        </Grid>

        <!-- Inference Settings Card Bar -->
        <Border Grid.Row="5" Background="{DynamicResource SettingsBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" IsEnabled="{Binding IsIdle}" Padding="15,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">      
                <TextBlock Text="Temperature:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>        
                <Slider x:Name="TemperatureSlider" Width="90" Minimum="0" Maximum="2.0" SmallChange="0.1" TickFrequency="0.1" Margin="6,0,10,0"
                        Value="{Binding Temperature, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ElementName=TemperatureSlider, Path=Value, StringFormat={}{0:F1}}" VerticalAlignment="Center" Width="25" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Separator Background="{DynamicResource BorderBrush}" Margin="8,0" Width="1" Height="15"/>

                <TextBlock Text="Top P:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>       
                <Slider x:Name="TopPSlider" Width="90" Minimum="0" Maximum="1.0" SmallChange="0.05" TickFrequency="0.05" Margin="6,0,10,0"
                        Value="{Binding TopP, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ElementName=TopPSlider, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" Width="30" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Separator Background="{DynamicResource BorderBrush}" Margin="8,0" Width="1" Height="15"/>

                <TextBlock Text="Max Tokens:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>  
                <TextBox Width="55" VerticalContentAlignment="Center" Margin="6,0,0,0" Padding="4,2" FontSize="11.5"
                         Text="{Binding MaxTokens, Mode=TwoWay}"
                         Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Separator Background="{DynamicResource BorderBrush}" Margin="12,0" Width="1" Height="15"/>

                <TextBlock Text="GPU Layers:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>  
                <TextBox Width="45" VerticalContentAlignment="Center" Margin="6,0,0,0" Padding="4,2" FontSize="11.5"
                         Text="{Binding GpuLayerCount, Mode=TwoWay}"
                         Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Separator Background="{DynamicResource BorderBrush}" Margin="12,0" Width="1" Height="15"/>

                <TextBlock Text="Ctx Size:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>    
                <TextBox Width="55" VerticalContentAlignment="Center" Margin="6,0,15,0" Padding="4,2" FontSize="11.5"
                         Text="{Binding ContextSize, Mode=TwoWay}"
                         Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
 
                <Button Content="Apply Settings" Padding="12,4" Command="{Binding ReloadModelCommand}" ToolTip="Apply Settings &amp; Reload Model" FontSize="11.5"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="6" Background="{DynamicResource StatusBarBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Margin="4,0" />
            </StatusBarItem>
            <Separator Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="5,0"/>
            <StatusBarItem Grid.Column="2">
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <TextBlock Text="Model: " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ModelName}" FontSize="11" />
                </StackPanel>
            </StatusBarItem>
            <Separator Grid.Column="3" Background="{DynamicResource BorderBrush}" Margin="5,0"/>
            <StatusBarItem Grid.Column="4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TPS: " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TPS, StringFormat={}{0:F2}}" FontSize="11" Margin="0,0,15,0"/>
                    <TextBlock Text="Ctx Tokens: " FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding ContextUsageString}" Foreground="{Binding ContextUsageBrush}" FontWeight="SemiBold" FontSize="11" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="5" HorizontalAlignment="Right" Margin="4,0">
                <ProgressBar IsIndeterminate="True" Width="110" Height="14" 
                             Visibility="{Binding IsIdle, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>