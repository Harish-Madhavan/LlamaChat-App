<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#09090B" />
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#09090B" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#27272A" />
    
    <!-- Accent / Button Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#27272A" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3F3F46" />
    
    <!-- CodeBlock / Card Colors -->
    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="#18181B" />
    
    <!-- Chat Bubbles -->
    <SolidColorBrush x:Key="UserBubbleBackgroundBrush" Color="#312E81" />
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#E0E7FF" />
    <SolidColorBrush x:Key="AssistantBubbleBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="AssistantBubbleTextBrush" Color="#FAFAFA" />
    
</ResourceDictionary>
