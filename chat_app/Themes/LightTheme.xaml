<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F9F9FB" />
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#71717A" />
    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E4E7" />
    
    <!-- Accent / Button Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D4D4D8" />
    
    <!-- CodeBlock / Card Colors -->
    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="#F4F4F5" />
    
    <!-- Chat Bubbles -->
    <SolidColorBrush x:Key="UserBubbleBackgroundBrush" Color="#E0E7FF" />
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#1E1B4B" />
    <SolidColorBrush x:Key="AssistantBubbleBackgroundBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="AssistantBubbleTextBrush" Color="#18181B" />
    
</ResourceDictionary>
